# Copy this file to .env.local for local development.
# In Vercel: Project Settings → Environment Variables.
# Anything starting with VITE_ is visible in the browser — never put secrets there.

# Temporary admin gate. Change this before sharing the live URL.
# Checked again on the server for every admin write.
VITE_ADMIN_PASSCODE=gracefield
ADMIN_PASSCODE=gracefield

# Supabase — Project Settings → API
# VITE_ values are used in the browser. The service role key is server-only.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — used to email clients when Francess changes a booking status.
# Create a free key at https://resend.com. Until you verify a domain, use
# beth.t@example.com as the from address.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Gracefield Living in Care <beth.t@example.com>
SITE_URL=https://gracefieldliveincare.vercel.app
