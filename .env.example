# Copy this file to .env.local for local development.
# In Vercel: Project Settings → Environment Variables.
# Anything starting with VITE_ is visible in the browser. Only the public
# Supabase URL and anon key should use that prefix.

# Admin gate — server only. Do not prefix this with VITE_.
ADMIN_PASSCODE=gracefield

# Supabase — Project Settings → API
# VITE_ values are used in the browser (anon key is designed to be public; RLS protects data).
# The service role key is server-only and must never use a VITE_ prefix.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — used for the contact form and for emails when a booking status changes.
# Create a free key at https://resend.com. Until you verify a domain, use
# onboarding@resend.dev as the from address. The test sender can only deliver
# to the Resend account email, so verify a domain before going live.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Gracefield Living in Care <onboarding@resend.dev>
CONTACT_TO_EMAIL=gracefieldliveincare@gmail.com
SITE_URL=https://gracefieldliveincare.vercel.app
