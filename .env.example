# Copy this file to .env.local for local development.
# In Vercel: Project Settings → Environment Variables.
# Anything starting with VITE_ is visible in the browser. Only the public
# Supabase URL and anon key should use that prefix.

# Admin gate — server only. Do not prefix this with VITE_.
ADMIN_PASSCODE=gracefield

# Supabase — Project Settings → API
# VITE_ values are used in the browser (anon key is designed to be public; RLS protects data).
# The service role key is server-only and must never use a VITE_ prefix.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — used for the contact form and for emails when a booking status changes.
# Verify gracefieldliveincare.com in Resend, then send from an address on that domain.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Gracefield Living in Care <hello@gracefieldliveincare.com>
CONTACT_TO_EMAIL=gracefieldliveincare@gmail.com
SITE_URL=https://www.gracefieldliveincare.com

# Zoho Mail — used to create a work mailbox when a carer is accepted.
# Leave blank until the one-time Zoho login is done. Do not commit secrets.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ZOID=
# Optional. Defaults shown.
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
# ZOHO_MAIL_API_URL=https://mail.zoho.com
